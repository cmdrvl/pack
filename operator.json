{
  "schema_version": "operator.v1",
  "name": "pack",
  "tool_version": "0.7.1",
  "contract_version": "1.0.0",
  "description": "Seal lockfiles, reports, rules, registry artifacts, and profile identity into immutable evidence packs",
  "repository": "https://github.com/cmdrvl/pack",
  "license": "MIT",
  "agent_guide": "https://github.com/cmdrvl/.github/blob/main/profile/AGENT_PROMPT.md",
  "invocation": {
    "binary": "pack",
    "usage": [
      "pack seal <ARTIFACT>... --out <DIR>",
      "pack verify <PACK_DIR> --json",
      "pack render <PACK_DIR> --format <html|md> --out <FILE>",
      "pack capabilities --json",
      "pack doctor --json"
    ],
    "output_mode": "mixed",
    "output_schema": "pack.v0",
    "json_flag": "--json"
  },
  "arguments": [],
  "options": [
    { "name": "out", "flag": "--out", "aliases": ["--output"], "type": "path", "scope": "seal", "description": "Output directory; --output is a compatibility alias" },
    { "name": "json", "flag": "--json", "type": "boolean", "description": "Emit machine-readable output where supported" },
    { "name": "no-witness", "flag": "--no-witness", "type": "boolean", "description": "Suppress witness ledger recording" },
    { "name": "describe", "flag": "--describe", "type": "boolean", "description": "Print the operator.v1 contract and exit" },
    { "name": "schema", "flag": "--schema", "type": "boolean", "description": "Print pack.v0 JSON Schema and exit" },
    { "name": "robot-triage", "flag": "--robot-triage", "type": "boolean", "description": "Legacy alias for doctor triage" },
    { "name": "version", "flag": "--version", "type": "boolean", "description": "Print version and exit" }
  ],
  "commands": [
    {
      "name": "seal",
      "description": "Seal artifacts into an immutable evidence pack directory",
      "options": [
        { "name": "out", "flag": "--out", "aliases": ["--output"], "type": "path" },
        { "name": "note", "flag": "--note", "type": "string" },
        { "name": "created", "flag": "--created", "type": "RFC3339" },
        { "name": "outcome", "flag": "--outcome", "type": "string" }
      ],
      "refusals": [
        { "code": "E_EMPTY" },
        { "code": "E_IO" },
        { "code": "E_DUPLICATE" }
      ]
    },
    { "name": "verify", "description": "Verify pack integrity and schema eligibility", "status": "implemented" },
    { "name": "render", "description": "Render a verified pack as a self-contained HTML or Markdown audit dossier", "status": "implemented", "read_only": false },
    { "name": "inspect", "description": "Read pack metadata without verifying integrity", "status": "implemented", "witness": "not_recorded" },
    { "name": "diff", "description": "Deterministically diff two packs", "status": "implemented" },
    { "name": "archive", "description": "Export or import deterministic tar wrappers", "status": "implemented", "witness": "not_recorded" },
    { "name": "witness", "description": "Query the witness ledger" },
    { "name": "capabilities", "description": "Print the same operator.v1 contract as --describe", "read_only": true, "commands": ["pack capabilities --json"] },
    { "name": "robot-docs", "description": "Print paste-ready operating notes for agents", "read_only": true, "commands": ["pack robot-docs guide"] },
    {
      "name": "doctor",
      "description": "Read-only health, capabilities, and triage diagnostics",
      "aliases": ["doctor health", "doctor --robot-triage"],
      "read_only": true,
      "status": "implemented",
      "witness": "not_recorded",
      "fix_mode": "not_available"
    }
  ],
  "exit_codes": {
    "0": { "meaning": "successful seal, valid verify, no-change diff, or healthy doctor", "domain": "positive" },
    "1": { "meaning": "invalid verify, changed diff, or unhealthy doctor", "domain": "negative" },
    "2": { "meaning": "refusal or command-line error", "domain": "error" }
  },
  "refusals": [
    { "code": "E_EMPTY", "message": "Seal called with no artifacts", "action": "escalate" },
    { "code": "E_IO", "message": "Cannot read input, write output, or read pack directory", "action": "escalate" },
    { "code": "E_DUPLICATE", "message": "Member path collision during seal", "action": "escalate" },
    { "code": "E_BAD_PACK", "message": "Missing or invalid manifest.json", "action": "escalate" }
  ],
  "env_vars": [
    { "name": "EPISTEMIC_WITNESS", "description": "Optional witness ledger path" },
    { "name": "NO_COLOR", "description": "Disable ANSI terminal styling" },
    { "name": "TERM", "description": "Terminal capability hint" },
    { "name": "SOURCE_DATE_EPOCH", "description": "Deterministic seal creation timestamp" }
  ],
  "formats": ["pack.v0 JSON", "pack.v0 directory", "operator.v1 JSON", "cmdrvl.doctor.v1 JSON"],
  "side_effects": {
    "reads_files": true,
    "writes_files": true,
    "network": false,
    "writes_witness": true,
    "notes": "Seal, render, and archive import write artifacts; doctor and introspection commands are read-only."
  },
  "manifest_member_fields": ["path", "bytes_hash", "type", "artifact_version", "profile_frozen", "profile_sha256", "column_registry_hash"],
  "capabilities": {
    "formats": ["pack.v0", "json"],
    "profile_aware": true,
    "profile_identity": {
      "member_type_predicate": "YAML with schema_version plus profile_id remains type=profile",
      "frozen_predicate": "status: frozen plus profile_sha256",
      "registry_hash_policy": "copy declared column_registry_hash when present",
      "artifact_version_policy": "profile schema_version is not emitted as artifact_version"
    },
    "streaming": false,
    "witness": {
      "ambient_recording": "enabled_by_default",
      "query_subcommands": true,
      "no_witness_flag": "suppresses_recording"
    },
    "composition": {
      "family": { "name": "cmdrvl-spine" },
      "position": 5,
      "produces": ["pack.v0 directory"],
      "accepts": ["lock.v0 JSON", "canon.v0 JSON", "rvl.v0 JSON"]
    },
    "doctor": {
      "read_only": true,
      "robot_triage": true,
      "top_level_surfaces": [
        "pack --robot-triage",
        "pack capabilities --json",
        "pack robot-docs guide"
      ],
      "fix_mode": "not_available"
    }
  },
  "pipeline": {
    "upstream": ["lock", "canon", "rvl"],
    "downstream": []
  }
}
